# scene composition config
scene.landtiles_chance = 0
scene.warped_rocks_chance = 0

# --- Added configs ---

# Render options for modified render.py script:

postprocess_bbox_annotations.enable_bbox_extraction = True
postprocess_bbox_annotations.create_visualizations = True # For debugging

# Minimum pixels for valid bbox
# Lower values = detect smaller/more distant objects
# Higher values = filter out tiny objects and reduce noise
postprocess_bbox_annotations.min_pixel_threshold = 150

flat_shading = True # For GT generation, required for segmentation masks

# Ensure correct pass saving
render_image.passes_to_save = [
    ("object_index", "IndexOB"),  # Required for bbox extraction
    ("z", "Depth"),
    ("normal", "Normal"),
    ("vector", "Vector"),
]
render_image.override_num_samples = 400  # Use 128+ for production. Can be enabled later



# Bbox render class mapping (COCO format)
# get_object_class_mapping.return_value = {
#     "car": 2,
#     "truck": 7,
#     "bus": 5,
# }


